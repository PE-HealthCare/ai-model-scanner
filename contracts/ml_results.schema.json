{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ML Classification Results",
  "type": "object",
  "required": [
    "producer",
    "mock_status",
    "contract_version",
    "generation_commit",
    "p_tamper",
    "shap_attributions",
    "model_version"
  ],
  "properties": {
    "producer": {
      "type": "string",
      "enum": [
        "P3"
      ]
    },
    "mock_status": {
      "type": "string",
      "enum": [
        "MOCK",
        "VERIFIED-REAL",
        "STALE"
      ]
    },
    "contract_version": {
      "type": "string"
    },
    "generation_commit": {
      "type": "string"
    },
    "p_tamper": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "shap_attributions": {
      "type": "object",
      "description": "Feature-level SHAP values keyed by the approved 10-feature static field names.",
      "propertyNames": {
        "enum": [
          "entropy",
          "pov_chi2",
          "lsb_kl",
          "ks_stat",
          "mean",
          "std",
          "skewness",
          "kurtosis",
          "sparsity",
          "outlier_pct"
        ]
      },
      "additionalProperties": {
        "type": "number"
      }
    },
    "model_version": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
